# Local SQLite (default). Path is relative to the project root.
DATABASE_URL="file:./dev.db"

# Each source may override maxPages/requestDelayMs/retries/timeoutMs in its config.
SCRAPE_MAX_PAGES=20
SCRAPE_REQUEST_DELAY_MS=1000
SCRAPE_RETRIES=2
SCRAPE_TIMEOUT_MS=20000
# Worker interval (minutes) and missing-job grace period (hours).
SCRAPE_INTERVAL_MINUTES=360
SCRAPE_DEACTIVATE_AFTER_HOURS=48

# Neon / Postgres example (do not commit real passwords):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional direct (non-pooler) URL, used only by Prisma migrations.
# DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Shared by Vercel Production and the GitHub Actions secret of the same name.
# After a successful scrape, Actions POSTs this value to /api/revalidate.
# Generate with: openssl rand -base64 32
# Do not commit a real value.
# REVALIDATE_SECRET=""
