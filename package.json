{
  "name": "boardline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "node scripts/build-production.mjs",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:watch": "tsx scripts/scrape.ts --watch",
    "test": "tsx --test src/lib/crawlers/*.test.ts src/lib/db/*.test.ts src/lib/board-query.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
